--Tabla Transaccion.Factura
create table Transaccion.Factura(
	id_Transaccion int identity(1,1) not null,
	UUID char(36) not null,
	CFDI_Nombre_Archivo nvarchar(120) not null,
	CFDI_Version decimal(4,2) not null,
	CFDI_Serie nvarchar(32),
	CFDI_Folio nvarchar(32),
	CFDI_Fecha datetime2(0) not null,
	CFDI_Subtotal decimal(12,2) not null,
	CFDI_Total decimal(12,2) not null,
	Clave_Moneda char(3) not null,
	CFDI_Tipo_Comprobante char(1) not null,
	CFDI_Metodo_Pago char(3) not null,
	CFDI_Forma_Pago char(2) not null,
	Emisor_RFC varchar(13) not null,
	Emisor_Nombre nvarchar(240) not null,
	Emisor_Regimen_Fiscal smallint not null,
	Receptor_RFC varchar(13) not null,
	Receptor_Nombre nvarchar(240) not null,
	Receptor_Uso_CFDI char(3) not null,
	Concepto_No_Identificacion nvarchar(128),
	Concepto_Descripcion nvarchar(240) not null,
	id_Producto_Servicio int not null,
	Concepto_Cantidad decimal(12,2) not null,
	Clave_Unidad varchar(3) not null,
	Concepto_Unidad nvarchar(128),
	Concepto_Valor_Unitario decimal(12,2) not null,
	Concepto_Importe decimal(12,2) not null,
	Concepto_Descuento decimal(12,2) not null,
	Impuesto_IVA_Base decimal(12,2) not null,
	Impuesto_IVA_TasaCuota decimal(3,2) not null,
	Impuesto_IVA_Importe decimal(12,2) not null,
	Impuesto_IEPS_Base decimal(12,2) not null,
	Impuesto_IEPS_TasaCuota decimal(3,2) not null,
	Impuesto_IEPS_Importe decimal(12,2) not null,
	--Clave primaria
	constraint pk_Transaccion_Factura_id_Transaccion
	primary key(id_Transaccion),
	--Claves foráneas
	constraint fk_Transaccion_Factura_UUID
	foreign key(UUID)
	references Proveedor.Factura(UUID),

	constraint fk_Transaccion_Factura_Clave_Moneda
	foreign key(Clave_Moneda)
	references SAT.Catalogo_Moneda(Clave_Moneda),

	constraint fk_Transaccion_Factura_id_Producto_Servicio
	foreign key(id_Producto_Servicio)
	references SAT.Catalogo_Producto_Servicio(id_Producto_Servicio),

	constraint fk_Transaccion_Factura_Clave_Unidad
	foreign key(Clave_Unidad)
	references SAT.Catalogo_Unidad_Medidas(Clave_Unidad),

	--Validacíón de datos
	constraint chk_Transaccion_Factura_CFDI_Tipo_Comprobante
	check(CFDI_Tipo_Comprobante in ('I','i')), --Solo se aceptan CFDI de Ingresos = I

	constraint chk_Transaccion_Factura_CFDI_Metodo_Pago
	check(CFDI_Metodo_Pago in ('PUE','PPD')),--PUE Pago en una sola exhibición 
											 --PPD Pago en parcialidades o diferido
	constraint chk_Transaccion_Factura_CFDI_Forma_Pago
	check(CFDI_Forma_Pago like '[0-9][0-9]'),--Dos dígitos numéricos

	constraint chk_Transaccion_Factura_Emisor_RFC
	check(len(Emisor_RFC) in (12,13)),--Solo 12 o 13 caracteres

	constraint chk_Transaccion_Factura_Receptor_RFC
	check(len(Receptor_RFC) in (12,13)),--Solo 12 o 13 caracteres

	constraint chk_Transaccion_Factura_UUID
	CHECK(UUID LIKE '[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]')
); --Fin de create table Transaccion.Factura, creada

