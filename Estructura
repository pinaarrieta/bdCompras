--Tabla de facturas emitidas por proveedores  
create table Proveedor.Factura(id_Factura int identity(1,1) not null, 
							   Ejercicio int not null,
							   Mes int not null,
							   UUID char(36) not null,
							   Serie varchar(24),
							   Folio varchar(24),
							   Fecha date not null,
							   Subtotal decimal(12,2) not null,
							   Descuento decimal(12,2) not null default 0,
							   Total_Impuestos_Trasladados decimal (12,2) not null default 0,
							   Total decimal(12,2) not null,
							   id_Proveedor int not null,
							   id_Empresa int not null,
							   Link_CFDI nvarchar(240) not null default 'No Disponible',
							   --Clave primaria
							   constraint pk_Proveedor_Factura_id_Factura
							   primary key(id_Factura),
							   							   
							   --Claves foráneas
							   constraint fk_Proveedor_Factura_idProveedor
							   foreign key(id_Proveedor)
							   references Proveedor.Nombre(id_Proveedor),

							   constraint fk_Proveedor_Factura_id_Empresa
							   foreign key(id_Empresa)
							   references  Empresa.Nombre(id_Empresa),

							   -- Índices
							   index ix_Proveedor_Factura_id_Proveedor_Fecha(id_Proveedor, Fecha),

							   --Validación de datos 

							   constraint chk_Proveedor_Factura_Ejercicio
							   check(Ejercicio >= 2025 and Ejercicio <= 2035),

							   constraint chk_Proveedor_Factura_Mes
							   check(Mes between 1 and 12),

							   constraint uq_Proveedor_Factura
							   unique(UUID),

							   constraint chk_Proveedor_Factura_UUID
							   CHECK (UUID LIKE '[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]')
							  );-- Creado

--	Crea la vista
create view vw_Proveedor_Factura as
select pf.id_Factura as ID,
	   pf.Ejercicio as EJERCICIO,
	   pf.Mes as MES,
	   pf.UUID as [FOLIO FISCAL],
	   pf.Serie as SERIE,
	   pf.Folio as FOLIO,
	   pf.Fecha as FECHA,
	   pf.Subtotal as SUBTOTAL,
	   pf.Descuento as DESCUENTO,
	   pf.Total_Impuestos_Trasladados as [IMPUESTOS TRASLADADOS],
	   pf.Total as TOTAL,
	   pn.RFC as [RFC EMISOR],
	   pn.Razon_Social as [PROVEEDOR],
	   en.RFC as [RFC RECEPTOR],
	   en.Razon_Social as EMPRESA
	from Proveedor.Factura pf
	join Proveedor.Nombre pn
		on pf.id_Proveedor = pn.id_Proveedor
	join Empresa.Nombre en
		on pf.id_Empresa = en.id_Empresa
	   ; --Creada

select * from vw_Proveedor_Factura; --ok


